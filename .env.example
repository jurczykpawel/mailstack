# Deployment config for generating wrangler.toml (NOT secrets — secrets go via `wrangler secret put`).
# Copy to .env and fill in; `npm run setup` substitutes these into wrangler.toml.
#   cp .env.example .env

# D1 database ids. Create the main and preview databases once:
#   wrangler d1 create mailstack
#   wrangler d1 create mailstack-preview
MAILSTACK_D1_ID=
MAILSTACK_D1_PREVIEW_ID=

# Optional custom domain for the Worker (leave empty to use the default *.workers.dev URL).
# Its zone must live in the same Cloudflare account as the Worker.
MAILSTACK_ROUTE=

# Brand the Sellf webhook (/v1/hooks/sellf) uses when a request omits ?brand= (default: acme).
SELLF_DEFAULT_BRAND=

# Optional SES configuration set for message events (no open/click tracking).
SES_CONFIGURATION_SET=
