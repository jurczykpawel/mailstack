# Deployment config for generating wrangler.toml (NOT secrets — secrets go via `wrangler secret put`).
# Copy to .env and fill in; `npm run setup` substitutes these into wrangler.toml.
#   cp .env.example .env

# D1 database ids. Create the main and preview databases once:
#   wrangler d1 create mailstack
#   wrangler d1 create mailstack-preview
MAILSTACK_D1_ID=
MAILSTACK_D1_PREVIEW_ID=

# Optional custom domain for the Worker (leave empty to use the default *.workers.dev URL).
# Its zone must live in the same Cloudflare account as the Worker.
MAILSTACK_ROUTE=
# Optional second custom domain serving only /internal/v2/* for the panel (needs MAILSTACK_ROUTE and the
# PANEL_ASSERTION_KEYS secret; the panel signs assertions for this host). Put it behind Cloudflare Access. Setting MAILSTACK_ROUTE disables workers.dev.
MAILSTACK_INTERNAL_ROUTE=
# Required with MAILSTACK_INTERNAL_ROUTE: the Access team host (<team>.cloudflareaccess.com) and the
# Application Audience (AUD) tag of the Access application on that host. The Worker checks the Access JWT.
MAILSTACK_ACCESS_TEAM_DOMAIN=
MAILSTACK_ACCESS_AUD=

# Brand the Sellf webhook (/v1/hooks/sellf) uses when a request omits ?brand= (default: acme).
SELLF_DEFAULT_BRAND=

# Optional SES configuration set for message events (no open/click tracking).
SES_CONFIGURATION_SET=
# Optional absolute path of a Mailstack Pro checkout: scoped API keys on the Worker.
MAILSTACK_PRO_PATH=
# https origin of the egress service behind a Tunnel for webhooks and resend source (Pro; secrets EGRESS_KEYS,
# EGRESS_ACCESS_CLIENT_ID, EGRESS_ACCESS_CLIENT_SECRET). Empty keeps them disabled.
MAILSTACK_EGRESS_URL=
