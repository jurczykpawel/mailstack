meta {
  name: Health check
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.ok: eq true
  res.body.service: eq mailstack
}

docs {
  # Health check

  Liveness probe — no auth, no brand. Returns
  `ok`, `service`, `version`, `commit` and `store` (`ok` or `down`); Pro builds
  also identify `proCommit`. A 200 alone does not establish store readiness.

  Run this first to confirm the Worker is up and `{{baseUrl}}` points at it
  before exercising the rest of the collection.
}
