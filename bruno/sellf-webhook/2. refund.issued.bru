meta {
  name: 2. refund.issued
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/hooks/sellf?brand=acme
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "event": "refund.issued",
    "timestamp": "2026-06-11T10:00:00.000Z",
    "data": {
      "customer": { "email": "buyer@example.com", "firstName": "Jane", "lastName": "Smith" },
      "product": { "name": "Pro Plan" },
      "refund": { "amount": 4999, "currency": "usd", "stripeRefundId": "re_test_123", "isFullRefund": true, "totalRefunded": 4999, "refundedAt": "2026-06-11T10:00:00.000Z" },
      "payment": { "id": "pay_test_123", "sessionId": "cs_test_123" }
    }
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

docs {
  # Sellf webhook: refund.issued -> refund

  Maps to the `refund` template with subject "Zwrot środków". The body contains
  49.99 USD, product name, payment and refund IDs, full refund scope, cumulative
  49.99 USD and the refund timestamp. transactionId selects paymentIntentId
  before sessionId. Each distinct stripeRefundId identifies a separate delivery.
  Missing required mapped fields return 422 invalid_event_data, without sending.
}
