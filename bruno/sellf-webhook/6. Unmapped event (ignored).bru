meta {
  name: 6. Unmapped event (ignored)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/hooks/sellf?brand=acme
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "event": "custom.event",
    "timestamp": "2026-06-15T09:00:00.000Z",
    "data": {
      "customer": { "email": "buyer@example.com" },
      "product": { "name": "Pro Plan" }
    }
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.ignored: eq custom.event
}

docs {
  # Sellf webhook: unmapped event

  Events with no entry in the Sellf source preset (e.g. `custom.event`)
  are intentionally **acked** with `200 {success:true, ignored:"<event>"}` so
  Sellf does not retry something we will never email. No mail is sent.

  Missing/invalid recipients on a mapped send event return
  `422 invalid_event_data` before delivery.
}
