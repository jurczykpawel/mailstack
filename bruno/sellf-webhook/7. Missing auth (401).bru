meta {
  name: 7. Missing auth (401)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/hooks/sellf?brand=acme
  body: json
  auth: none
}

body:json {
  {
    "event": "purchase.completed",
    "timestamp": "2026-06-10T09:30:00.000Z",
    "data": {
      "customer": { "email": "buyer@example.com", "firstName": "Jane", "lastName": "Smith" },
      "product": { "name": "Pro Plan" },
      "order": { "amount": 4999, "currency": "usd", "sessionId": "cs_test_123" }
    }
  }
}

assert {
  res.status: eq 401
  res.body.success: eq false
  res.body.message: eq unauthorized
}

docs {
  # Sellf webhook: missing / invalid auth

  Without Authorization: Bearer, the handler returns 401 unauthorized before
  parsing the body. Clients with a configured signing secret additionally
  require a valid X-Sellf-Signature; a signature does not replace the bearer.
}
