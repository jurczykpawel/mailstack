{
  "version": 1,
  "brands": {
    "acme": {
      "id": "acme",
      "name": "Acme Inc.",
      "from": "Acme Inc. <hello@acme.example>",
      "to": [
        "inbox@acme.example"
      ],
      "allowedOrigins": [
        "https://acme.example",
        "https://www.acme.example",
        "http://localhost:4321",
        "http://localhost:4322",
        "http://localhost:4323"
      ],
      "subjectPrefix": "New message from",
      "autoReply": true,
      "turnstileAction": "contact",
      "theme": {
        "accent": "#0064BC",
        "accent2": "#A8D603",
        "logoUrl": "https://mail.example.com/brand/logo.png",
        "siteUrl": "https://acme.example",
        "address": "123 Example Street, 00-000 Example City",
        "phone": "+00 000 000 000"
      },
      "licenseActivationUrls": {
        "bundle": "https://source.test.example/activate/bundle",
        "component": "https://source.test.example/activate/component"
      }
    },
    "demo": {
      "id": "demo",
      "name": "Demo Brand",
      "from": "Demo Brand <noreply@demo.example>",
      "to": [
        "team@demo.example"
      ],
      "allowedOrigins": [
        "https://demo.example",
        "http://localhost:4321"
      ],
      "subjectPrefix": "New message",
      "captcha": "altcha",
      "theme": {
        "accent": "#008AFF",
        "accent2": "#A8D603",
        "siteUrl": "https://demo.example"
      },
      "licenseActivationUrls": {}
    }
  },
  "cloudflare": {
    "plan": "free"
  },
  "logging": {
    "defaults": {
      "level": "meta",
      "contentDays": 30,
      "metaDays": 90,
      "requireLog": false,
      "resend": "off",
      "alertOn": [],
      "includeSecrets": false
    },
    "ceilings": {
      "contentDays": 90,
      "metaDays": 400,
      "auditDays": 400
    },
    "patterns": [],
    "brands": {}
  },
  "sources": {
    "sellf": {
      "signature": {
        "scheme": "t-v1",
        "header": "X-Sellf-Signature",
        "toleranceSeconds": 300
      },
      "envelope": {
        "event": "event",
        "timestamp": "timestamp",
        "data": "data"
      },
      "events": {
        "purchase.completed": {
          "action": "send",
          "template": "payment",
          "to": "data.customer.email",
          "fields": {
            "name": {
              "join": [
                "data.customer.firstName",
                "data.customer.lastName"
              ]
            },
            "amount": {
              "path": "data.order.amount",
              "as": "money-minor"
            },
            "currency": {
              "path": "data.order.currency",
              "as": "upper"
            },
            "item": "data.product.name",
            "orderId": {
              "first": [
                "data.order.orderId",
                "data.order.paymentIntentId",
                "data.order.sessionId"
              ]
            },
            "date": {
              "path": "timestamp",
              "as": "date-pl"
            },
            "settledVia": "data.order.settledVia"
          },
          "ref": {
            "first": [
              "data.order.orderId",
              "data.order.paymentIntentId",
              "data.order.sessionId"
            ]
          },
          "idempotencyKey": {
            "first": [
              "data.order.orderId",
              "data.order.paymentIntentId",
              "data.order.sessionId"
            ]
          },
          "transform": "purchase-licenses"
        },
        "refund.issued": {
          "action": "send",
          "template": "refund",
          "to": "data.customer.email",
          "fields": {
            "amount": {
              "path": "data.refund.amount",
              "as": "money-minor"
            },
            "currency": {
              "path": "data.refund.currency",
              "as": "upper"
            },
            "productName": "data.product.name",
            "transactionId": {
              "first": [
                "data.payment.paymentIntentId",
                "data.payment.sessionId"
              ]
            },
            "paymentId": "data.payment.id",
            "refundId": "data.refund.stripeRefundId",
            "isFullRefund": {
              "path": "data.refund.isFullRefund",
              "as": "map",
              "map": {
                "boolean:true": "true",
                "boolean:false": "false"
              }
            },
            "totalRefunded": {
              "path": "data.refund.totalRefunded",
              "as": "money-minor"
            },
            "refundedAt": "data.refund.refundedAt",
            "reason": "data.refund.reason"
          },
          "ref": {
            "first": [
              "data.payment.paymentIntentId",
              "data.payment.sessionId"
            ]
          },
          "idempotencyKey": "data.refund.stripeRefundId"
        },
        "waitlist.signup": {
          "action": "send",
          "template": "notice",
          "to": "data.customer.email",
          "fields": {
            "heading": {
              "format": "Jesteś na liście oczekujących"
            },
            "paragraphs": {
              "format": "Dziękujemy za zapis na: {data.product.name}.\n\nDamy znać, gdy produkt będzie dostępny."
            }
          },
          "ref": {
            "first": [
              "data.order.sessionId",
              "data.order.paymentIntentId",
              "data.payment.sessionId",
              "data.payment.paymentIntentId"
            ]
          },
          "idempotencyKey": {
            "first": [
              "data.order.sessionId",
              "data.order.paymentIntentId",
              "data.payment.sessionId",
              "data.payment.paymentIntentId"
            ]
          }
        },
        "lead.captured": {
          "action": "send",
          "template": "welcome",
          "to": "data.customer.email",
          "fields": {
            "name": {
              "format": ""
            },
            "intro": {
              "format": "Twój dostęp do {data.product.name} jest gotowy."
            }
          },
          "ref": {
            "first": [
              "data.order.sessionId",
              "data.order.paymentIntentId",
              "data.payment.sessionId",
              "data.payment.paymentIntentId"
            ]
          },
          "idempotencyKey": {
            "first": [
              "data.order.sessionId",
              "data.order.paymentIntentId",
              "data.payment.sessionId",
              "data.payment.paymentIntentId"
            ]
          }
        },
        "access.expired": {
          "action": "send",
          "template": "notice",
          "to": "data.customer.email",
          "fields": {
            "heading": {
              "format": "Dostęp wygasł"
            },
            "paragraphs": {
              "format": "Twój dostęp do {data.product.name} wygasł.\n\nJeśli chcesz go odnowić, odpowiedz na tę wiadomość."
            }
          },
          "ref": {
            "first": [
              "data.order.sessionId",
              "data.order.paymentIntentId",
              "data.payment.sessionId",
              "data.payment.paymentIntentId"
            ]
          },
          "idempotencyKey": {
            "first": [
              "data.order.sessionId",
              "data.order.paymentIntentId",
              "data.payment.sessionId",
              "data.payment.paymentIntentId"
            ]
          }
        },
        "subscription.created": {
          "action": "reject"
        },
        "subscription.updated": {
          "action": "reject"
        },
        "subscription.canceled": {
          "action": "reject"
        },
        "subscription.trial_ending": {
          "action": "reject"
        },
        "subscription.renewal_upcoming": {
          "action": "reject"
        },
        "invoice.paid": {
          "action": "reject"
        },
        "invoice.payment_failed": {
          "action": "reject"
        },
        "license.revoked": {
          "action": "reject"
        },
        "order.placed": {
          "action": "send",
          "template": "bank-transfer",
          "to": "data.customer.email",
          "fields": {
            "orderId": "data.order.orderId",
            "holder": "data.order.transfer.holder",
            "account": "data.order.transfer.account",
            "bank": "data.order.transfer.bank",
            "title": "data.order.transfer.title",
            "amount": {
              "path": "data.order.amount",
              "as": "money-minor"
            },
            "currency": {
              "path": "data.order.currency",
              "as": "upper"
            },
            "deadline": "data.order.paymentDeadline",
            "orderUrl": "data.order.payUrl",
            "reminder": {
              "format": "false"
            }
          },
          "ref": "data.order.orderId",
          "idempotencyKey": "data.order.orderId"
        },
        "order.payment_reminder": {
          "action": "send",
          "template": "bank-transfer",
          "to": "data.customer.email",
          "fields": {
            "orderId": "data.order.orderId",
            "holder": "data.order.transfer.holder",
            "account": "data.order.transfer.account",
            "bank": "data.order.transfer.bank",
            "title": "data.order.transfer.title",
            "amount": {
              "path": "data.order.amount",
              "as": "money-minor"
            },
            "currency": {
              "path": "data.order.currency",
              "as": "upper"
            },
            "deadline": "data.order.paymentDeadline",
            "orderUrl": "data.order.payUrl",
            "reminder": {
              "format": "true"
            }
          },
          "ref": "data.order.orderId",
          "idempotencyKey": "data.order.orderId"
        },
        "order.cancelled": {
          "action": "send",
          "template": "notice",
          "to": "data.customer.email",
          "fields": {
            "heading": {
              "format": "Zamówienie anulowane"
            },
            "paragraphs": {
              "format": "Zamówienie {data.order.orderNumber} zostało anulowane.\n\nPowód: {data.order.cancelReason}.\n\n{data.order.cancelReasonText}"
            },
            "orderId": "data.order.orderId",
            "cancelReason": "data.order.cancelReason",
            "ctaUrl": "data.order.payUrl",
            "ctaLabel": {
              "format": "Zobacz zamówienie"
            }
          },
          "requiredFields": [
            "orderId",
            "cancelReason"
          ],
          "ref": "data.order.orderId",
          "idempotencyKey": "data.order.orderId"
        },
        "order.participants_needed": {
          "action": "send",
          "template": "notice",
          "to": "data.customer.email",
          "fields": {
            "heading": {
              "format": "Uzupełnij uczestników: {data.product.name}"
            },
            "paragraphs": {
              "path": "data.reminder.stage",
              "as": "map",
              "map": {
                "number:1": "Po 24 h lista uczestników nadal jest pusta.",
                "number:2": "Wydarzenie odbędzie się za 2 dni. Lista uczestników nadal jest pusta."
              }
            },
            "productName": "data.product.name",
            "orderId": "data.order.orderId",
            "ctaUrl": "data.reminder.participantsUrl",
            "ctaLabel": {
              "format": "Uzupełnij uczestników"
            }
          },
          "requiredFields": [
            "productName",
            "orderId",
            "ctaUrl"
          ],
          "ref": "data.order.orderId",
          "idempotencyKey": {
            "join": [
              "data.order.orderId",
              "data.reminder.stage"
            ]
          }
        },
        "access.granted": {
          "action": "send",
          "template": "welcome",
          "to": "data.customer.email",
          "fields": {
            "name": {
              "join": [
                "data.customer.firstName",
                "data.customer.lastName"
              ]
            },
            "intro": {
              "format": "Twój dostęp do {data.product.name} jest gotowy."
            },
            "body": {
              "format": "Zaloguj się na swoje konto w sklepie, aby otworzyć produkt."
            },
            "productName": "data.product.name",
            "accessId": "data.access.id",
            "grantSource": {
              "path": "data.grantSource",
              "as": "map",
              "map": {
                "string:free": "free",
                "string:purchase": "purchase",
                "string:bundle": "bundle",
                "string:bank_transfer": "bank_transfer",
                "string:subscription": "subscription",
                "string:manual": "manual",
                "string:unknown": "unknown"
              }
            }
          },
          "requiredFields": [
            "accessId",
            "productName",
            "grantSource"
          ],
          "ref": "data.access.id",
          "idempotencyKey": "data.access.id",
          "transform": "free-access"
        },
        "license.issued": {
          "action": "send",
          "template": "license",
          "to": "data.customer.email",
          "fields": {
            "name": {
              "join": [
                "data.customer.firstName",
                "data.customer.lastName"
              ]
            },
            "productName": "data.product.name",
            "productId": "data.product.id",
            "licenseKey": "data.licenseKey",
            "tier": "data.license.tier",
            "domain": "data.license.domain",
            "licenseId": "data.license.id",
            "licenseOrder": "data.license.order",
            "issuanceSource": {
              "path": "data.license.issuanceSource",
              "as": "map",
              "map": {
                "string:purchase": "purchase",
                "string:manual": "manual",
                "string:api": "api"
              }
            }
          },
          "requiredFields": [
            "licenseId",
            "licenseOrder",
            "issuanceSource",
            "productId"
          ],
          "ref": {
            "first": [
              "data.license.orderId",
              "data.license.order",
              "data.license.id"
            ]
          },
          "idempotencyKey": "data.license.id",
          "transform": "sellf-license"
        }
      }
    }
  }
}
