{
  "name": "mailstack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/ensure-config.mjs && node scripts/gen-wrangler.mjs",
    "prepare": "husky",
    "predev": "npm run setup",
    "dev": "wrangler dev",
    "predeploy": "npm run setup",
    "deploy": "wrangler deploy",
    "pretypecheck": "npm run setup",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run setup",
    "test": "vitest run",
    "keys": "node scripts/keys.mjs"
  },
  "dependencies": {
    "@hpke/core": "1.9.0",
    "@hpke/dhkem-x25519": "1.8.0",
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260719.1",
    "husky": "^9.1.7",
    "typescript": "^5.8.3",
    "vitest": "4.1.12",
    "wrangler": "^4.112.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
