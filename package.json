{
  "name": "mailstack",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/ensure-config.mjs && node scripts/bundle-config.ts && node scripts/gen-wrangler.mjs",
    "prepare": "husky",
    "predev": "npm run setup",
    "dev": "wrangler dev",
    "predeploy": "node scripts/deploy-guard.mjs && npm run setup",
    "deploy": "node scripts/deploy-guard.mjs --deploy",
    "migrate:worker": "node scripts/migrate-worker.ts --remote",
    "release": "node scripts/release.mjs",
    "pretypecheck": "node scripts/ensure-config.mjs && node scripts/bundle-config.ts --example && node scripts/gen-wrangler.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/ensure-config.mjs && node scripts/bundle-config.ts --example && node scripts/gen-wrangler.mjs",
    "test": "vitest run",
    "lint:migrations": "npm run pretest && vitest run test/store-migrations.test.ts test/worker-schema.test.ts",
    "mailstack": "node scripts/mailstack.ts",
    "keys": "node scripts/keys.mjs",
    "build:node": "node scripts/build-node.mjs",
    "start": "node dist/node-api.mjs"
  },
  "dependencies": {
    "@hpke/core": "1.9.0",
    "@hpke/dhkem-x25519": "1.8.0",
    "age-encryption": "0.3.1",
    "aws4fetch": "^1.0.20",
    "better-sqlite3": "^13.0.3",
    "kysely": "^0.29.7",
    "kysely-d1": "^0.4.0",
    "nodemailer": "10.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "8.0.2",
    "esbuild": "0.28.2",
    "husky": "^9.1.7",
    "miniflare": "^5.20261019.2-beta",
    "typescript": "^5.8.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.30.1"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
